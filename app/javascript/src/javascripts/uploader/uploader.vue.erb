<template>
    <div class="flex-grid-outer">
        <div class="col box-section" style="flex: 2 0 0;">
            <template v-for="section in sections" :key="section.key">
                <template v-if="section.kind === 'file'">
                    <div class="flex-grid border-bottom">
                        <div class="col">
                            <label class="section-label" for="post_file">{{ section.label }}</label>
                            <div class="hint" v-html="section.hint"></div>
                        </div>
                        <div class="col2">
                          <file-input @uploadValueChanged="uploadValue = $event"
                            @previewChanged="previewData = $event"
                            @invalidUploadValueChanged="invalidUploadValue = $event"></file-input>
                        </div>
                    </div>
                    <file-preview classes="box-section in-editor below-upload" :data="previewData"></file-preview>
                </template>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'sources'">
                    <div class="col">
                        <label class="section-label" for="post_sources">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <sources :maxSources="10" :showErrors="showErrors" v-model:sources="sources" @sourceWarning="sourceWarning = $event"></sources>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'tags'">
                    <div class="col">
                        <label class="section-label" :for="`post_${section.key}`">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <div class="box-section background-red" v-show="showErrors && missingRequiredTag(section)">
                            A tag in {{ section.label }} is required{{ section.requirement === "in_progress" ? " for in-progress uploads" : "" }}.
                        </div>
                        <template v-for="(row, index) in visibleRows(section)" :key="index">
                            <hr v-if="index > 0">
                            <div class="flex-wrap">
                                <image-checkbox :check="check" :checks="checkboxes.selected" v-for="check in row"
                                                @set="setCheck" :key="check.tag" :data-tag="check.tag"></image-checkbox>
                            </div>
                        </template>
                        <textarea class="tag-textarea" v-model="tagEntries[section.key]" :id="`post_${section.key}`" rows="2"
                                  :placeholder="section.placeholder" data-autocomplete="tag-edit"></textarea>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'character_groups'">
                    <div class="col">
                        <label class="section-label">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <character-group-editor param-name="upload" :native-names="false" @update:model-value="characterGroups = $event"></character-group-editor>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'rating'">
                    <div class="col">
                        <label class="section-label">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <div class="box-section background-red" v-if="showErrors && invalidRating">
                            You must select an appropriate rating for this image.
                        </div>
                        <div>
                            <template v-if="!safe">
                                <button class="toggle-button rating-e" :class="{active: rating==='e'}" @click="rating = 'e'">
                                    Explicit
                                </button>
                                <button class="toggle-button rating-q" :class="{active: rating==='q'}" @click="rating = 'q'">
                                    Questionable
                                </button>
                            </template>
                            <button class="toggle-button rating-s" :class="{active: rating==='s'}" @click="rating = 's'">Safe
                            </button>
                        </div>
                    </div>
                </div>
                <template v-else-if="section.kind === 'other_tags'">
                    <div class="flex-grid come-together-now">
                        <div class="col">
                            <label class="section-label" for="post_tags">{{ section.label }}</label>
                            <div v-html="section.hint"></div>
                        </div>
                        <div class="col2">
                          <file-preview classes="box-section in-editor" :data="previewData"></file-preview>
                            <div class="box-section background-red" v-show="showErrors && notEnoughTags">
                                You must provide at least <b>{{minimumTags - tagCount}}</b> more tags. Tags in other sections count
                                towards this total.
                            </div>
                            <div v-show="!tagPreview.show">
                                <textarea class="tag-textarea" id="post_tags" v-model="tagEntries.other" rows="5"
                                          ref="otherTags" data-autocomplete="tag-edit"></textarea>
                            </div>
                            <div v-show="tagPreview.show">
                                <tag-preview :tags="tagPreview.tags" :loading="tagPreview.loading"
                                             @close="previewFinalTags"></tag-preview>
                            </div>

                            <div class="related-tag-functions">
                                Related:
                                <a href="#" @click.prevent="findRelated()">Tags</a> |
                                <template v-for="category in relatedCategories" :key="category.id">
                                    <a href="#" @click.prevent="findRelated(category.id)">{{ category.header }}</a> |
                                </template>
                                <a href="#" @click.prevent="previewFinalTags">Preview Final Tags</a>
                            </div>
                        </div>
                    </div>
                    <div class="flex-grid border-bottom over-me">
                        <related-tags v-if="relatedTags.length" :tags="tagsArray" :related="relatedTags"
                                      :loading="loadingRelated"
                                      @tag-active="pushTag"></related-tags>
                    </div>
                </template>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'parent'">
                    <div class="col">
                        <label class="section-label">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <input v-model.number="parentID" :placeholder="section.placeholder"/>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'locked_tags'">
                    <div class="col">
                        <label class="section-label">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <input type="text" v-model="lockedTags" data-autocomplete="tag-query"/>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'lock_rating'">
                    <div class="col">
                        <label class="section-label">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <label><input type="checkbox" v-model="ratingLocked"/> Lock Rating</label>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'description'">
                    <div class="col">
                        <label class="section-label" for="post_description">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <%= ApplicationController.new.render_to_string(partial: "dtext_input", locals: { limit: AdminConfig.instance.post_description_max_size, textarea: '<textarea  class="dtext-formatter-input tag-textarea dtext" id="post_description" rows="10" v-model="description"></textarea>'.html_safe, allow_color: true }) %>
                    </div>
                </div>
                <div class="flex-grid border-bottom" v-else-if="section.kind === 'upload_options'">
                    <div class="col">
                        <label class="section-label">{{ section.label }}</label>
                        <div v-html="section.hint"></div>
                    </div>
                    <div class="col2">
                        <label v-if="allowUploadAsPending"><input type="checkbox" v-model="uploadAsPending"/> Upload As Pending<sup title="Puts the post straight into the pending queue for approval, even if you'd normally skip it." style="cursor: help; margin-left: 0.15em; font-size: 0.75em;">?</sup></label><br v-if="allowUploadAsPending && allowUploadAsInProgress">
                        <label v-if="allowUploadAsInProgress"><input type="checkbox" v-model="uploadAsInProgress"/> Upload As In Progress<sup title="Hides the post from search results until searched for directly, and lets you replace it instantly with no approval needed while you keep working on it. Push it into the pending queue yourself when you're done, or a janitor can force it in if it's abandoned." style="cursor: help; margin-left: 0.15em; font-size: 0.75em;">?</sup></label>
                    </div>
                </div>
            </template>
            <div class="flex-grid">
                <div class="col"></div>
                <div class="col2">
                    <div class="box-section background-red" v-show="preventUpload && showErrors">
                        Unmet requirements above prevent the submission of the post.
                    </div>
                    <div class="box-section background-green" v-show="submitting">
                        Submitting your post, please wait.
                    </div>
                    <div class="box-section background-red" v-show="error">
                        {{ error }}
                    </div>
                    <div class="box-section background-red" v-show="duplicateId">
                        Post is a duplicate of <a :href="duplicatePath">post #{{duplicateId}}.</a>
                    </div>
                    <button @click="submit" :disabled="(showErrors && preventUpload) || submitting" accesskey="s">
                        {{ submitting ? "Uploading..." : "Upload" }}
                    </button>
                </div>
            </div>
        </div>
        <div id="preview-sidebar" class="col box-section" style="margin-left: 10px; padding: 10px;">
            <file-preview classes="in-sidebar" :data="previewData"></file-preview>
        </div>
    </div>
</template>

<script>
  import sources from "./sources.vue";
  import checkbox from "./checkbox.vue";
  import relatedTags from "./related.vue";
  import tagPreview from "./tag_preview.vue";
  import filePreview from "./file_preview.vue";
  import fileInput from "./file_input.vue";
  import characterGroupEditor from "../character_group_editor.vue";
  import SparkMD5 from "spark-md5";
  import Uploader from "../uploader";
  import Autocomplete from "../autocomplete.js.erb";

  function tagSorter(a, b) {
    return a.name > b.name ? 1 : -1;
  }

  function unloadWarning() {
    if (this.allowNavigate || (this.uploadValue === "" && this.tags === "")) {
      return;
    }
    return true;
  }

  export default {
    components: {
      "sources": sources,
      "image-checkbox": checkbox,
      "related-tags": relatedTags,
      "tag-preview": tagPreview,
      "file-preview": filePreview,
      "file-input": fileInput,
      "character-group-editor": characterGroupEditor,
    },
    data() {
      const layout = Uploader.settings.layout || [];
      const tagEntries = { other: "" };
      for (const section of layout) {
        if (section.kind === "tags") tagEntries[section.key] = "";
      }

      return {
        safe: Uploader.settings.safe_site,
        showErrors: false,
        allowNavigate: false,
        submitting: false,

        previewData: {
          url: "",
          isVideo: false,
        },
        uploadValue: "",
        invalidUploadValue: false,

        sourceWarning: false,
        sources: [""],
        characterGroups: [],
        normalMode: !Uploader.settings.compact_mode,
        maxFileSizePerRequest: Uploader.settings.max_file_size_per_request,
        characterGroupsEnabled: Uploader.settings.character_groups_enabled,
        minimumTags: Uploader.settings.minimum_tags,
        layout: layout,

        checkboxes: {
          selected: {},
        },
        // the "other" box, plus one for each tags section, by key
        tagEntries: tagEntries,

        tagPreview: {
          loading: false,
          show: false,
          tags: []
        },

        allowLockedTags: Uploader.settings.allow_locked_tags,
        lockedTags: "",
        allowRatingLock: Uploader.settings.allow_rating_lock,
        ratingLocked: false,
        allowUploadAsPending: Uploader.settings.allow_upload_as_pending,
        allowUploadAsInProgress: Uploader.settings.allow_upload_as_in_progress,
        uploadAsPending: false,
        uploadAsInProgress: false,

        relatedTags: [],
        // every category but the default, which "Tags" already covers
        relatedCategories: (Autocomplete.TAG_CATEGORY_DATA.categories || []).filter(category => category.id !== Autocomplete.TAG_CATEGORY_DATA.default_id),
        lastRelatedCategoryId: undefined,
        loadingRelated: false,

        parentID: "",
        description: "",
        rating: "",
        error: "",
        duplicateId: 0,
      };
    },
    watch: {
      // hidden buttons are unselected, which can hide more buttons, so this runs again until nothing changes
      "checkboxes.selected": {
        deep: true,
        handler() {
          for (const button of this.buttons) {
            if (this.checkboxes.selected[button.tag] && !this.isVisible(button)) {
              this.checkboxes.selected[button.tag] = false;
            }
          }
        },
      },
    },
    mounted() {
      const self = this;
      window.onbeforeunload = unloadWarning.bind(self);
      const params = new URLSearchParams(window.location.search);
      const fillField = function(field, key) {
        if(params.has(key)) {
          self[field] = params.get(key);
        }
      };
      const fillFieldBool = function(field, key) {
        if(params.has(key)) {
          self[field] = (params.get(key) === "true");
        }
      };

      // Import tags from query parameters, tags-<key> goes into that tags section
      const fillTags = function() {
        if(params.has("tags"))
          self.importTags(params.get("tags"), "other");

        const tags = [];
        for(const [name, value] of params.entries()) {
          if(!name.startsWith("tags-")) continue;
          const key = name.replace("tags-", "");
          if(self.normalMode && key !== "other" && Object.hasOwn(self.tagEntries, key)) {
            self.importTags(value, key);
          } else {
            // compact mode only has the other box, as do sections that aren't shown
            tags.push(value);
          }
        }
        if(tags.length > 0)
          self.importTags(tags.join(" "), "other");
      };

      // Import the post rating from a query parameter
      const fillRating = function() {
        if(!params.has("rating")) return;
        const rating = params.get("rating")[0].toLowerCase();
        if(!/[sqe]/.test(rating)) return;
        self.rating = rating;
      };

      fillField("parentID", "parent");
      fillField("description", "description");
      fillTags();
      fillRating();
      if(params.has("sources")) {
        self.sources = params.get("sources").split(",");
      }
      if(this.allowRatingLock)
        fillFieldBool("ratingLocked", "rating_locked");
      if(this.allowLockedTags)
        fillField("lockedTags", "locked_tags");
      if(this.allowUploadAsPending)
        fillFieldBool("uploadAsPending", "upload_as_pending")
      if(this.allowUploadAsInProgress)
        fillFieldBool("uploadAsInProgress", "upload_as_in_progress")
    },
    methods: {
      setCheck(tag, value) {
        this.checkboxes.selected[tag] = value;
      },
      isVisible(button) {
        if (!button.shown_when.length) return true;
        const selected = (tag) => this.checkboxes.selected[tag] === true;
        return button.shown_when_mode === "all" ? button.shown_when.every(selected) : button.shown_when.some(selected);
      },
      // rows without any shown buttons are left out
      visibleRows(section) {
        return section.rows.map(row => row.filter(button => this.isVisible(button))).filter(row => row.length);
      },
      missingRequiredTag(section) {
        if (section.requirement === "none") return false;
        if (section.requirement === "in_progress" && !this.uploadAsInProgress) return false;
        if ((this.tagEntries[section.key] || "").trim()) return false;
        return !section.rows.flat().some(button => this.checkboxes.selected[button.tag] === true);
      },
      afterSuccess(data) {
        this.submitting = false;
        this.allowNavigate = true;
        Fennec.notice("Post uploaded successfully.");
        location.assign(data.location);
      },
      afterError(data) {
        this.submitting = false;
        const data2 = data.responseJSON;
        try {
          if (data2 && data2.reason === "duplicate") {
            this.duplicateId = data2.post_id;
          }
          if (data2 && ["duplicate", "invalid"].indexOf(data2.reason) !== -1) {
            this.error = data2.message;
          } else if (data2 && data2.message) {
            this.error = "Error: " + data2.message;
          } else {
            this.error = "Error: " + data2.reason;
          }
        } catch (e) {
          this.error = "Error: Unknown error! " + JSON.stringify(data2);
        }
      },
      uploadFiles(id) {
        const perRequest = this.maxFileSizePerRequest;
        const file = this.uploadValue;
        const chunks = Math.ceil(file.size / perRequest);

        const uploadChunk = (index) => {
          const start = index * perRequest;
          const end = Math.min(start + perRequest, file.size);
          const blob = file.slice(start, end);
          const formData = new FormData();
          formData.append("upload_media_asset[data]", blob);
          formData.append("upload_media_asset[chunk_id]", index + 1);
          $.ajax({
            url: `/media_assets/uploads/${id}/append.json`,
            type: "PUT",
            data: formData,
            processData: false,
            contentType: false,
            success: () => {
              if (index < chunks - 1) {
                uploadChunk(index + 1);
              } else {
                this.finalizeUpload(id);
              }
            },
            error: (data) => {
              this.cancelUpload(id);
              this.afterError(data);
            }
          });
        }
        uploadChunk(0);
      },
      finalizeUpload(id) {
        $.ajax({
          url: `/media_assets/uploads/${id}/finalize.json`,
          type: "PUT",
          success: (data) => {
            this.afterSuccess(data);
          },
          error: (data) => {
            this.cancelUpload(id);
            this.afterError(data);
          }
        });
      },
      cancelUpload(id) {
        $.ajax({
          url: `/media_assets/uploads/${id}/cancel.json`,
          type: "PUT"
        });
      },
      md5HashFile(file) {
        return new Promise((resolve, reject) => {
          const chunkSize = 1024 * 1024 * 2;
          const chunkCount = Math.ceil(file.size / chunkSize);
          let currentChunk = 0, hash = null;
          const spark = new SparkMD5.ArrayBuffer();
          const reader = new FileReader();

          reader.onload = function (e) {
            spark.append(e.target.result);
            currentChunk++;

            if (currentChunk < chunkCount) {
              loadNext();
            } else {
              resolve(spark.end());
            }
          }

          reader.onerror = reject;

          function loadNext() {
            const start = currentChunk * chunkSize;
            const end = Math.min(start + chunkSize, file.size);
            reader.readAsArrayBuffer(file.slice(start, end));
          }

          loadNext();
        });
      },
      async submit() {
        this.showErrors = true;
        this.error = "";
        if (this.preventUpload || this.submitting)
          return;
        this.submitting = true;
        const data = new FormData();
        let directUpload = false;
        if (typeof this.uploadValue === "string") {
          data.append("upload[direct_url]", this.uploadValue);
          directUpload = true
        } else {
          const md5 = await this.md5HashFile(this.uploadValue);
          data.append("upload[checksum]", md5);
          const small = this.uploadValue.size <= this.maxFileSizePerRequest;
          if (small) {
            data.append("upload[file]", this.uploadValue);
            directUpload = true
          }
        }
        data.append("upload[ungrouped_tag_string]", this.ungroupedTags);
        if (this.characterGroups.length === 0) {
          data.append("upload[character_groups_attributes][0][tags][]", "");
        } else {
          this.characterGroups.forEach((group, index) => {
            data.append(`upload[character_groups_attributes][${index}][characters][]`, group.characters.join(" "));
            data.append(`upload[character_groups_attributes][${index}][tags][]`, group.tags.join(" "));
          });
        }
        data.append("upload[rating]", this.rating);
        data.append("upload[source]", this.sources.join("\n"));
        data.append("upload[description]", this.description);
        data.append("upload[parent_id]", this.parentID);
        if (this.allowLockedTags)
          data.append("upload[locked_tags]", this.lockedTags);
        if (this.allowRatingLock)
          data.append("upload[locked_rating]", this.ratingLocked);
        if (this.allowUploadAsPending)
          data.append("upload[as_pending]", this.uploadAsPending);
        if (this.allowUploadAsInProgress)
          data.append("upload[as_in_progress]", this.uploadAsInProgress);
        jQuery.ajax("/uploads.json", {
          contentType: false,
          processData: false,
          method: "POST",
          type: "POST",
          data: data,
          success: (data) => {
            if (directUpload) {
              this.afterSuccess(data);
            } else {
              this.uploadFiles(data.media_asset_id);
            }
          },
          error: this.afterError.bind(this)
        });
      },
      pushTag(tag, add) {
        this.tagPreview.show = false;
        const button = this.buttonsByTag[tag];
        // In advanced mode we need to push these into the tags area because there are no checkboxes or other
        // tag fields so we can't see them otherwise. A hidden button would just be unselected again.
        if (button && this.normalMode && (!add || this.isVisible(button))) {
          this.setCheck(tag, add);
          return;
        }
        const tags = this.tagEntries.other ? this.tagEntries.other.trim().split(" ") : [];
        const tagIdx = tags.indexOf(tag);
        if (add) {
          if (tagIdx === -1)
            tags.push(tag);
        } else {
          if (tagIdx === -1)
            return;
          tags.splice(tagIdx, 1);
        }
        this.tagEntries.other = tags.join(" ") + " ";
      },

      /**
       * Used to import tags from the query parameters
       * @param {string} tags Raw tag string
       * @param {string} input Which of the tagEntries the tags should be added to
       */
      importTags(tags, input) {
        this.tagPreview.show = false;
        const tagsA = (tags + "").trim().split(" ").filter(n => n);

        // Dedupe
        let tagsB = this.normalMode ? [] : (this.tagEntries.other || "").trim().split(" ");
        const checked = [];
        tagsA.forEach((tag) => {
          if(tagsB.indexOf(tag) >= 0) return;
          // In advanced mode, checkboxes are not available
          if(this.normalMode && this.buttonsByTag[tag]) {
            this.setCheck(tag, true);
            checked.push(tag);
            return;
          }
          tagsB.push(tag);
        });
        // all of them are selected first, since buttons can be shown by ones that come later
        for (const tag of checked) {
          if (this.isVisible(this.buttonsByTag[tag])) continue;
          this.setCheck(tag, false);
          tagsB.push(tag);
        }

        // Without a space at the end, vue panics
        this.tagEntries[this.normalMode ? input : "other"] = tagsB.join(" ") + " ";
      },

      previewFinalTags() {
        if (this.tagPreview.loading)
          return;
        if (this.tagPreview.show) {
          this.tagPreview.show = false;
          return;
        }
        this.tagPreview.loading = true;
        this.tagPreview.show = true;
        this.tagPreview.tags = [];
        const self = this;
        const data = {tags: this.tags};
        $.ajax("/tags/preview.json", {
          method: "GET",
          data: data,
          success: function (result) {
            self.tagPreview.loading = false;
            self.tagPreview.tags = result;
          },
          error: function (result) {
            self.tagPreview.loading = false;
            self.tagPreview.tags = [];
            self.tagPreview.show = false;
            Fennec.error("Error loading tag preview " + result);
          }
        })
      },
      findRelated(categoryId) {
        const self = this;
        if (self.loadingRelated)
          return;
        if (self.relatedTags.length > 0 && self.lastRelatedCategoryId === categoryId) {
          self.relatedTags = [];
          return;
        }
        const convertResponse = function (respData) {
          const sortedRelated = [];
          for (const key in respData) {
            if (!respData.hasOwnProperty(key))
              continue;
            if (!respData[key].length)
              continue;
            sortedRelated.push({title: "Related: " + key, tags: respData[key].sort(tagSorter)});
          }
          return sortedRelated;
        };
        const getSelectedTags = function () {
          // an array, since it's inside the sections loop
          const field = [].concat(self.$refs["otherTags"])[0];
          if (!field)
            return null;
          if (!field.hasOwnProperty("selectionStart"))
            return null;
          const length = field.selectionEnd - field.selectionStart;
          if (length)
            return field.value.substr(field.selectionStart, length);
          return null;
        };
        this.loadingRelated = true;
        this.relatedTags = [];
        const selectedTags = getSelectedTags();
        const params = selectedTags ? {query: selectedTags} : {query: this.tags};

        if (categoryId)
          params["category_id"] = categoryId;
        $.getJSON("/tags/related/bulk.json", params, function (data) {
          self.relatedTags = convertResponse(data);
          self.lastRelatedCategoryId = categoryId;
        }).always(function () {
          self.loadingRelated = false;
        });
      },
    },
    computed: {
      // the sections the user sees, compact mode only shows some of them
      sections() {
        return this.layout.filter((section) => {
          if (!this.normalMode && !section.show_in_compact_mode) return false;
          switch (section.kind) {
            case "character_groups": return this.characterGroupsEnabled;
            case "locked_tags": return this.allowLockedTags;
            case "lock_rating": return this.allowRatingLock;
            case "upload_options": return this.allowUploadAsPending || this.allowUploadAsInProgress;
            default: return true;
          }
        });
      },
      buttons() {
        return this.sections.filter(section => section.kind === "tags").flatMap(section => section.rows.flat());
      },
      buttonsByTag() {
        return Object.fromEntries(this.buttons.map(button => [button.tag, button]));
      },
      characterGroupTagsFlat() {
        return this.characterGroups.flatMap((g) => [...g.characters, ...g.tags]).join(" ");
      },
      // Everything except the character-group tags - this is what's actually submitted as
      // upload[ungrouped_tag_string]; the groups are submitted separately, structured.
      ungroupedTags() {
        if (!this.normalMode)
          return this.tagEntries.other;
        const checked = this.buttons.filter(button => this.checkboxes.selected[button.tag] === true).map(button => button.tag);
        return checked.concat(Object.values(this.tagEntries)).join(" ").replace(",", " ").trim().replace(/ +/g, " ");
      },
      // Full tag set including character-group tags - used for the tag count/validation/preview/related-tag
      // features below, which should treat a character's tags the same as any other tag on the post.
      tags() {
        return `${this.ungroupedTags} ${this.characterGroupTagsFlat}`.trim().replace(/ +/g, " ");
      },
      tagsArray() {
        return this.tags.toLowerCase().split(" ");
      },
      tagCount: function () {
        return this.tags.split(" ").filter(function (x) {
          return x;
        }).length;
      },
      notEnoughTags: function () {
        // In-progress uploads only need the required sections (see missingRequiredTags) - everything else
        // gets finished up before the post is pushed into the pending queue.
        if (this.uploadAsInProgress)
          return false;
        return this.tagCount < this.minimumTags;
      },
      missingRequiredTags: function () {
        return this.sections.some(section => section.kind === "tags" && this.missingRequiredTag(section));
      },
      invalidRating: function () {
        return !this.rating;
      },
      preventUpload: function () {
        return this.sourceWarning || this.notEnoughTags || this.missingRequiredTags
          || this.invalidRating || this.invalidUploadValue;
      },
      duplicatePath: function () {
        return `/posts/${this.duplicateId}`;
      }
    }
  }
</script>
