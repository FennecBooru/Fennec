<%= nav_link_to("", "/", class: "mobile-logo") %>
<% if CurrentUser.user.is_anonymous? %>
  <%= nav_link_to("Sign in", new_session_path) %>
<% else %>
  <%= nav_link_to("Notifications #{unread_notifications(CurrentUser.user)}", notifications_path, class: (CurrentUser.user.has_unread_notifications? ? "unread" : nil)) %>
<% end %>
<%= nav_link_to("Posts", posts_path) %>
<%= nav_link_to_if(Feature.enabled?(:comments), "Comments", comments_path(group_by: "post")) %>
<%= nav_link_to_if(Feature.enabled?(:artist_pages), "Artists", artists_path) %>
<%= nav_link_to_if(Feature.enabled?(:character_pages), "Characters", characters_path) %>
<%= nav_link_to("Tags", tags_path) %>
<%= nav_link_to_if(Feature.enabled?(:pools), "Pools", gallery_pools_path) %>
<%= nav_link_to_if(Feature.enabled?(:post_sets), "Sets", post_sets_path) %>
<%= nav_link_to_if(Feature.enabled?(:wiki), "Wiki", show_or_new_wiki_pages_path(title: AdminConfig.instance.home_wiki_page)) %>
<% if Feature.enabled?(:forums) %>
  <%= nav_link_to("Forum", forums_path, "class": (CurrentUser.user.is_forum_unread? ? "forum-updated" : nil), "data-form": CurrentUser.user.forum_unread_form) %>
<% end %>
<%= nav_link_to_if(ModeratorDashboardPolicy.new(CurrentUser.user, nil).show?, "Dashboard", moderator_dashboard_path) %>
<%= nav_link_to_if(CurrentUser.user.is_member? && Feature.enabled?(:discord), "Discord", discord_get_path) %>
<%= nav_link_to("Help", help_pages_path) %>
<%= nav_link_to("More »", site_map_path) %>
