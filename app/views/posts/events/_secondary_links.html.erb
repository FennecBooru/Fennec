<% content_for(:secondary_links) do %>
  <%= subnav_link_to("Flags", post_flags_path(search: { post_id: params.dig(:search, :post_id) })) %>
  <%= subnav_link_to_if(Feature.enabled?(:post_approvals), "Approvals", post_approvals_path(search: { post_id: params.dig(:search, :post_id) })) %>
  <%= subnav_link_to("Replacements", post_replacements_path(search: { post_id: params.dig(:search, :post_id) })) %>
  <%= subnav_link_to("Tag History", post_versions_path(search: { post_id: params.dig(:search, :post_id) })) %>
<% end %>
