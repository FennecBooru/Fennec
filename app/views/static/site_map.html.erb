<% SiteMap.sections_for(CurrentUser.user).each do |section| %>
  <section>
    <h1><%= section[:title] %></h1>
    <ul>
      <% section[:links].each do |link| %>
        <%= li_link_to(link[:label], link[:path]) %>
      <% end %>
    </ul>
  </section>
<% end %>

<% content_for(:page_title) do %>
  Site Map
<% end %>
