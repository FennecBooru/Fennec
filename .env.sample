# The settings here, if defined, override the settings in config/database.yml,
# config/local_config.rb, and ~/.danbooru/{secret_token,session_secret_key}.
#
# `.env.$RAILS_ENV` takes precedence over .env, and .env.local takes
# precedence over .env and `.env.$RAILS_ENV`.
#
# In other words: put your shared config in .env.local, and your put
# environment-specific config in .env.development / .env.production / .env.test.

#
# Rails
#

# These take precedence over ~/.danbooru/{secret_token,session_secret_key}.
# export SECRET_TOKEN=
# export SESSION_SECRET_KEY=

# Override the normal Gemfile with another file.
# export BUNDLE_GEMFILE=

# Logs a stacktrace for each SQL query.
# export QUERY_TRACE=

#
# Danbooru
#

# These take precedence over config/local_config.rb. Any setting in
# default_config.rb can be defined here by prefixing it with `FENNEC_`.

# export FENNEC_APP_NAME=
# export FENNEC_VERSION=
# export FENNEC_HOSTNAME=

# Admin-editable config (the `admin_config` table, edited at /admin/config) can also be pinned to
# a fixed value via FENNEC_ADMIN_CONFIG_<NAME>, using the column name - e.g. to force signups
# closed regardless of what's saved in the DB:
# export FENNEC_ADMIN_CONFIG_ENABLE_SIGNUPS=false
# A pinned option can no longer be changed from the admin UI.

# "Login with YiffSpace" (Logto-based Discord OAuth, via the yiffspace-auth gem). Register an
# app in the Logto tenant with redirect URI ${FENNEC_HOSTNAME}/auth/yiffspace/cb to get these.
# export FENNEC_LOGTO_CLIENT_ID=
# export FENNEC_LOGTO_CLIENT_SECRET=
# export FENNEC_LOGTO_RESOURCE=
# Only needed for instant permission revocation (webhook-driven) and admin dedup tooling.
# export FENNEC_LOGTO_API_CLIENT_ID=
# export FENNEC_LOGTO_API_CLIENT_SECRET=
# export FENNEC_LOGTO_API_RESOURCE=
# Only needed if something calls Client#fetch_discord_user - not used by the login flow itself.
# export FENNEC_LOGTO_DISCORD_BOT_TOKEN=

# Ships unexpected (500-class) exceptions, including background job failures, to an
# OpenObserve instance for alerting/search. Leave ENDPOINT unset to disable entirely.
# export FENNEC_OPENOBSERVE_ENDPOINT=
# export FENNEC_OPENOBSERVE_ORGANIZATION=
# export FENNEC_OPENOBSERVE_STREAM=
# export FENNEC_OPENOBSERVE_USERNAME=
# export FENNEC_OPENOBSERVE_PASSWORD=

#
# Development Only
#

#
# When wanting to run as the non-root user, you must set these variables to
# avoid file permission errors. If not set the container will default
# to the root user. Use `id -u` to print the UID and `id -g` for the GID.
#
# HOST_UID=
# HOST_GID=
# DOCKER_USER=fennec

# discord: Starts the discord integration to join users to a discord server.
#          The application must have its OAuth2 redirect URI set to ${JOINER_BASE_URL}/callback.
#          You also need to fill out all the JOINER_* environment variables below.
# metrics: Starts the *-metrics sidecar containers (postgres, redis, elasticsearch, memcached,
#          nginx exporters) and, in the fennec container itself, exposes the app's own
#          /metrics endpoint (Puma/Yabeda stats) on port 9394 - see config/metrics.rb.
# Combine multiple profiles with a comma, e.g. COMPOSE_PROFILES=discord,metrics
# COMPOSE_PROFILES=discord

# Explicitly force the app's own /metrics endpoint on or off, overriding whatever
# COMPOSE_PROFILES says - e.g. to expose it without also starting the *-metrics sidecars.
# METRICS_ENABLED=true

# Change the ports that are forwarded by docker to avoid potential conflicts

# EXPOSED_SERVER_PORT=4000
# EXPOSED_REPORTS_PORT=4001
# EXPOSED_JOINER_PORT=4002
# EXPOSED_WEBPACKER_PORT=4003
# EXPOSED_POSTGRES_PORT=34518
# EXPOSED_REDIS_PORT=34519

# The following environment variables are required when using the 'discord' profile:

# JOINER_BOT_TOKEN=
# JOINER_OAUTH2_CLIENT_ID=
# JOINER_OAUTH2_CLIENT_SECRET=
# JOINER_GUILD_ID=
# JOINER_FAILED_JOIN_WEBHOOK_URL=
